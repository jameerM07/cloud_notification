# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=college-cloud-notification-secret-key-2026

# Database Configuration
DATABASE_PATH=notifications.db

# Redis Message Queue Configuration
# Default local Redis address (works with native Redis, Docker, Memurai, or redis_dev_server.py)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Alternatively, supply a full URL:
# REDIS_URL=redis://127.0.0.1:6379/0

# Queue Names
NOTIFICATION_QUEUE=notification_queue
PROCESSING_QUEUE=notification_processing_queue

# Worker Configuration
# Simulated delivery delay in seconds (for realistic demo)
SIMULATION_DELAY_SECONDS=2.0
